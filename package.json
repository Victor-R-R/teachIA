{
  "name": "teachia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "npx tsx scripts/seed-exercises.ts",
    "db:seed-flashcards": "npx dotenv -e .env.local -- npx tsx scripts/seed-flashcards.ts",
    "db:migrate-flashcards": "npx dotenv -e .env.local -- npx tsx scripts/migrate-flashcards.ts",
    "db:migrate": "npx dotenv -e .env.local -- node -e \"const { neon } = require('@neondatabase/serverless'); const fs = require('fs'); const sql = neon(process.env.DATABASE_URL); sql.query(fs.readFileSync('./scripts/migrate.sql', 'utf8')).then(() => { console.log('Migration complete'); process.exit(0); }).catch(err => { console.error(err); process.exit(1); })\"",
    "db:migrate-multitenant": "npx tsx scripts/migrate-multitenant.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/react": "^3.0.151",
    "@auth/pg-adapter": "^1.11.1",
    "@base-ui/react": "^1.3.0",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.27.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.153",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.0",
    "headroom-ai": "^0.1.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "media-chrome": "^4.18.3",
    "motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-jsx-parser": "^2.4.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.2",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.3"
  }
}
